{
  "name": "nexoclip-app",
  "description": "Open-source alternative to HF AI — AI image, video, cinema and lip sync studio",
  "homepage": "https://github.com/Anil-matcha/Open-Generative-AI",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/studio",
    "packages/Vibe-Workflow/packages/workflow-builder",
    "packages/Open-Poe-AI/packages/agents",
    "packages/Open-AI-Design-Agent/packages/design-agent"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:storyboard": "cd services/vimax/web && VIMAX_PYTHON_CMD=\"$(cd .. && pwd)/.venv/bin/python\" node server.mjs",
    "dev:vimax-runtime": "cd services/vimax && VIMAX_RUNTIME_TOKEN=\"${VIMAX_RUNTIME_TOKEN:?Set VIMAX_RUNTIME_TOKEN (match .env.local)}\" VIMAX_TENANTS_ROOT=\"$(pwd)/.tenants\" .venv/bin/uvicorn runtime_api.app:app --host 127.0.0.1 --port 4174",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:studio": "npm run build -w studio",
    "build:workflow": "npm run build -w workflow-builder",
    "build:agent": "npm run build -w ai-agent",
    "build:design": "npm run build -w design-agent",
    "build:packages": "npm run build:workflow && npm run build:agent && npm run build:design && npm run build:studio",
    "setup": "npm install && npm run build:packages",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "db:migrate": "node src/db/migrate.js",
    "config:check": "node scripts/production-config.mjs",
    "worker:recover": "node scripts/worker-recover.mjs",
    "worker:storyboard": "node src/queue/storyboardWorker.mjs",
    "worker:image": "node --env-file-if-exists=.env.local src/queue/imageWorker.mjs",
    "worker:video": "node --env-file-if-exists=.env.local src/queue/videoWorker.mjs",
    "pi:task": "bash scripts/pi-task.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@napi-rs/canvas": "0.1.80",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@remotion/lottie": "^4.0.533",
    "@remotion/media": "4.0.533",
    "@remotion/player": "^4.0.533",
    "@remotion/web-renderer": "4.0.533",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "ai-agent": "file:./packages/Open-Poe-AI/packages/agents",
    "axios": "^1.7.0",
    "bullmq": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "jose": "6.2.12",
    "lottie-web": "^5.12.2",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "^15.0.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "remotion": "^4.0.533",
    "sharp": "^0.34.3",
    "studio": "*",
    "tailwind-merge": "^2.6.2",
    "typescript": "^5.9.3",
    "workflow-builder": "file:./packages/Vibe-Workflow/packages/workflow-builder"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/vite": "^4.1.18",
    "autoprefixer": "^10.4.24",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0"
  }
}
