:80 {
	encode zstd gzip

	route {
		handle_path /ai-clip-api/* {
			reverse_proxy ai-clip:4175
		}

		handle /canvas/api/internal/* {
			respond 404
		}

		handle /spite/api/internal/* {
			respond 404
		}

		handle /api/internal/* {
			respond 404
		}

		handle /canvas/api/workspace-assets* {
			uri replace /canvas/api/workspace-assets /api/assets
			reverse_proxy nexoclip:3000
		}

		handle /canvas/ws* {
			reverse_proxy spite-realtime:3007
		}

		handle /canvas* {
			reverse_proxy spite:3005
		}

		# Canonical public path is /canvas. Move old /spite bookmarks over.
		redir /spite /canvas 308
		redir /spite/* /canvas/{path} 308

		# Backward compatibility for old bookmarks; new navigation uses /canvas.
		handle /spite/api/workspace-assets* {
			uri replace /spite/api/workspace-assets /api/assets
			reverse_proxy nexoclip:3000
		}

		handle /spite/ws* {
			reverse_proxy spite-realtime:3007
		}

		handle /spite* {
			reverse_proxy spite:3005
		}

		handle {
			reverse_proxy nexoclip:3000
		}
	}
}
