:80 {
	encode zstd gzip

	route {
		handle_path /ai-clip-api/* {
			reverse_proxy {$AI_CLIP_UPSTREAM:ai-clip:4175}
		}

		handle /canvas/api/internal/* {
			respond 404
		}

		handle /spite/api/internal/* {
			respond 404
		}

		handle /api/internal/* {
			respond 404
		}

		handle /canvas/api/workspace-assets* {
			uri replace /canvas/api/workspace-assets /api/assets
			reverse_proxy {$NEXOCLIP_UPSTREAM:nexoclip-app:3000}
		}

		handle /canvas/ws* {
			reverse_proxy {$SPITE_REALTIME_UPSTREAM:spite-realtime:3007}
		}

		handle /canvas* {
			reverse_proxy {$SPITE_UPSTREAM:spite:3005}
		}

		# Legacy clients (stale cached JS bundle from before the /spite ->
		# /canvas basePath migration) may still open a WebSocket to
		# /spite/ws. A WS upgrade handshake does NOT follow HTTP redirects
		# — the browser just fails the connection — so this MUST be
		# proxied directly, ahead of the catch-all redirect below, instead
		# of silently becoming unreachable dead code behind it.
		handle /spite/ws* {
			reverse_proxy {$SPITE_REALTIME_UPSTREAM:spite-realtime:3007}
		}

		# Canonical public path is /canvas. Move old /spite bookmarks over.
		redir /spite /canvas 308
		redir /spite/* /canvas/{path} 308

		# Backward compatibility for old bookmarks; new navigation uses /canvas.
		handle /spite/api/workspace-assets* {
			uri replace /spite/api/workspace-assets /api/assets
			reverse_proxy {$NEXOCLIP_UPSTREAM:nexoclip-app:3000}
		}

		handle /spite* {
			reverse_proxy {$SPITE_UPSTREAM:spite:3005}
		}

		handle {
			reverse_proxy {$NEXOCLIP_UPSTREAM:nexoclip-app:3000}
		}
	}
}
